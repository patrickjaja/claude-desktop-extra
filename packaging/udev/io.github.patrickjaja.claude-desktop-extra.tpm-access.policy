<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  claude-desktop-extra: lets Settings -> Extra -> Cowork (Linux)
  run cdb-tpm-access (enable | disable) through pkexec. The action matches only
  the helper's absolute path; each change asks for an administrator password.
-->
<policyconfig>
  <vendor>claude-desktop-extra</vendor>
  <vendor_url>https://github.com/patrickjaja/claude-desktop-extra</vendor_url>

  <action id="io.github.patrickjaja.claude-desktop-extra.tpm-access">
    <description>Change Claude Desktop TPM access</description>
    <message>Authentication is required to change whether Claude Desktop can use this computer's TPM for its device identity key</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/claude-desktop/resources/linux-udev/cdb-tpm-access</annotate>
  </action>
</policyconfig>
